# 运行时环境变量模板：复制为 .env 后按需修改。
#
# 这里只放**进程真正读取**的变量。端口映射、镜像名、数据卷路径属于部署参数，
# 写在下发命令（docker run -p / -v）或 Kubernetes 清单里，不要放进本文件。
#
#   cp .env.example .env
#   # 填 ALKH_MASTER_KEY / ALKH_PUBLIC_BASE_URL / ALKH_ADMIN_PASSWORD
#   docker run --env-file .env ...
#
# 全部变量与默认值见 README §2.3「环境变量」。

# --- 日志 ---
ALKH_LOG_LEVEL=info
ALKH_LOG_JSON=false

# --- 管理后台初始账号（仅首次启动生效）---
ALKH_ADMIN_USERNAME=admin
# 留空则随机生成并打印到日志；生产环境请显式设置
ALKH_ADMIN_PASSWORD=

# --- 安全 ---
# 32 字节主密钥，64 位 hex 或 base64。用于加密存储飞书 app_secret。
# 生成示例：openssl rand -hex 32
# 注意：一旦丢失将无法解密已保存的 app_secret，需要重新填写。
ALKH_MASTER_KEY=
# 通过 HTTPS 访问时置为 true
# 一般不用设：不填时按 ALKH_PUBLIC_BASE_URL 是否为 https 自动判断
ALKH_COOKIE_SECURE=false

# --- 对外地址（用于生成 AlertManager hook 地址）---
ALKH_PUBLIC_BASE_URL=http://localhost:8080

# --- 飞书 ---
ALKH_LARK_BASE_URL=https://open.feishu.cn
# Lark 国际版请改为 https://open.larksuite.com

# --- 接收端点限流 ---
# 未认证的接收端点限流：每个来源 IP、每 10 秒的请求数上限（0 = 关闭）
ALKH_HOOK_RATE_LIMIT=300
